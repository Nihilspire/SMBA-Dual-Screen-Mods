; quad.v.pica - the top screen's only shader: a position and a texture coordinate, passed through.
.fvec projection[4]
.constf one(1.0, 1.0, 1.0, 1.0)
.out outpos position
.out outtc texcoord0
.alias inpos v0
.alias intc v1
.proc main
	mov r0.xyz, inpos
	mov r0.w, one
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov outtc, intc
	end
.end
