diff --git a/src/arm/arm.c b/src/arm/arm.c
index 0b92d7f..ad6309e 100644
--- a/src/arm/arm.c
+++ b/src/arm/arm.c
@@ -226,14 +226,23 @@ static inline void ThumbStep(struct ARMCore* cpu) {
 	instruction(cpu, opcode);
 }
 
+/* Dual: NO SLOWDOWN overclock. Instruction cycles are halved, so the CPU runs 2x relative to video, sound, timers
+ * and DMA (all event-driven). Halt/IntrWait skip to the next event as before. */
+int gbx_overclock = 0;
+static int gbx_oc_rem;
+#define GBX_STEP(STEP) do { \
+		int32_t _c0 = cpu->cycles; STEP(cpu); \
+		if (gbx_overclock) { int32_t _d = cpu->cycles - _c0 + gbx_oc_rem; gbx_oc_rem = _d & 1; cpu->cycles = _c0 + (_d >> 1); } \
+	} while (0)
+
 void ARMRun(struct ARMCore* cpu) {
 	while (cpu->cycles >= cpu->nextEvent) {
 		cpu->irqh.processEvents(cpu);
 	}
 	if (cpu->executionMode == MODE_THUMB) {
-		ThumbStep(cpu);
+		GBX_STEP(ThumbStep);
 	} else {
-		ARMStep(cpu);
+		GBX_STEP(ARMStep);
 	}
 	while (cpu->cycles >= cpu->nextEvent) {
 		cpu->irqh.processEvents(cpu);
@@ -243,11 +252,11 @@ void ARMRun(struct ARMCore* cpu) {
 void ARMRunLoop(struct ARMCore* cpu) {
 	if (cpu->executionMode == MODE_THUMB) {
 		while (cpu->cycles < cpu->nextEvent) {
-			ThumbStep(cpu);
+			GBX_STEP(ThumbStep);
 		}
 	} else {
 		while (cpu->cycles < cpu->nextEvent) {
-			ARMStep(cpu);
+			GBX_STEP(ARMStep);
 		}
 	}
 	cpu->irqh.processEvents(cpu);
